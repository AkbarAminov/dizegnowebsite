generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String?
  year        Int?
  description String?
  production  String?
  order       Int      @default(0)
  // Pinned projects sort before unpinned ones on the public site.
  pinned      Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images ProjectImage[]
  fields ProjectField[]

  @@index([published, pinned, order])
}

enum ProjectImageType {
  image
  gif
  youtube
}

model ProjectImage {
  id        String           @id @default(cuid())
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // For "youtube" this is the embed URL (https://www.youtube.com/embed/<id>).
  url       String
  // Videos store a 16:9 placeholder so every row has real dimensions.
  width     Int
  height    Int
  order     Int              @default(0)
  type      ProjectImageType @default(image)
  // "cover" (crop to fill the tile) or "contain" (show the whole image).
  fitMode   String           @default("cover")

  @@index([projectId, order])
}

// Free-form credit rows (e.g. "Client", "Award") editable from the admin UI.
model ProjectField {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  value     String
  order     Int     @default(0)

  @@index([projectId, order])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
