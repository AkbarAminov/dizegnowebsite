# Postgres (docker compose up -d db starts one on port 5433)
DATABASE_URL="postgresql://dizegno:dizegno@localhost:5433/dizegno"

# The only account that can sign in at /admin/login
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Signs the admin session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: Telegram notifications for contact-form submissions
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional: SMTP email notifications for contact-form submissions
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_TO=""
