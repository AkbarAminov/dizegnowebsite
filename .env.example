# Single place for all configuration. `make env` copies this file to .env;
# docker/compose.yml and the app both read .env.

# --- MySQL container (local development) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=dizegno
MYSQL_PASSWORD=dizegno
MYSQL_DATABASE=dizegno
# Host port for GUI clients or for running the app outside Docker
MYSQL_PORT=3307

# --- App container ---
# Host port: http://localhost:APP_PORT
APP_PORT=3000

# Only used when running the app outside Docker; inside Docker the URL is
# built from the MYSQL_* values above.
DATABASE_URL=mysql://dizegno:dizegno@localhost:3307/dizegno

# The only account that can sign in at /admin/login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Signs the admin session cookie (make env fills it in; or: openssl rand -base64 32)
AUTH_SECRET=

# --- Optional: Telegram notifications for contact-form submissions ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: SMTP email notifications for contact-form submissions ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=
