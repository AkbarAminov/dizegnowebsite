# Managed by Ansible — edit ansible/roles/app/templates/env.j2.
#
# Compose interpolates variables inside env_file, so a literal "$" in a value
# has to be written as "$$" or everything from it on is eaten. Passwords come
# from the vault and may contain anything, hence the escaping below.
NODE_ENV=production
DATABASE_URL=mysql://{{ mysql_user }}:{{ mysql_password_url }}@host.docker.internal:{{ mysql_port }}/{{ mysql_db }}

AUTH_SECRET={{ auth_secret | replace('$', '$$') }}
ADMIN_EMAIL={{ admin_email | replace('$', '$$') }}
ADMIN_PASSWORD={{ admin_password | replace('$', '$$') }}

TELEGRAM_BOT_TOKEN={{ telegram_bot_token | replace('$', '$$') }}
TELEGRAM_CHAT_ID={{ telegram_chat_id | replace('$', '$$') }}

EMAIL_HOST={{ email_host | replace('$', '$$') }}
EMAIL_PORT={{ email_port }}
EMAIL_USER={{ email_user | replace('$', '$$') }}
EMAIL_PASS={{ email_pass | replace('$', '$$') }}
EMAIL_TO={{ email_to | replace('$', '$$') }}
